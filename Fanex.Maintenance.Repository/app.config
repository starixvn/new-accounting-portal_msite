<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
        <section name="NapSettings" type="Fanex.NAP.Core.Configuration.NapSettings, Fanex.NAP.Core" />
    </configSections>
    
    <runtime>
        <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
            <dependentAssembly>
                <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
                <bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" />
            </dependentAssembly>
        </assemblyBinding>
    </runtime>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
    </startup>
    <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
        <providers>
            <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="$resourcePath_Value" enableWatching="1" />
        </providers>
    </Fanex.Data.DbSettingProvider>
    <appSettings>
        <add key="app_mail_address" value="$app_mail_address_value" />
        <add key="app_mail_id" value="$app_mail_id_value" />
    </appSettings>
    <NapSettings Environment="UAT" EnableDirectLogin="1" SiteId="67" UnauthorizeUrl="~/Home/NonePermission" EnableReCheckin="false" HubUrl="http://localhost:54332/NAPHub" ServiceUrls="http://10.18.200.124:1710/api" AccessKey="zU1yEh4KD+zzNkake1nWcXhgxrmMFihRLszarWBDJuw=">
        <Domain>
            <add Name="10.18.200.209:7123" Path="/" />
        </Domain>
    </NapSettings>
</configuration>
