@{
    ViewBag.Title = "Delete Parlay Locking";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model Fanex.DeleteTempVariable.Requests.ParlayLockingRequest
@section Head {
    @Styles.Render("~/css/manage")
}
@section Headline {
    <h1>
        <span class="title">@ViewBag.Title</span>
    </h1>
}
@using (Html.BeginForm("Index", "DeleteParlayLocking", FormMethod.Post, new { name = "parlayLockingForm", id = "parlayLockingForm" }))
{
    <section id="filter-bar" style="width: 84%">
        <div class="filter-form">
            <div class="lbl-field width-auto">
                MatchId
            </div>
            <div class="edit-field">
                @Html.TextBox("MatchId", Model.MatchId)
            </div>
            <div class="lbl-field width-auto">
                Time
            </div>
            <div class="edit-field">
                @Html.DropDownListFor(m => m.TimeRange, new List<SelectListItem>
                {
                    new SelectListItem{Text="1h", Value="1"},
                    new SelectListItem{Text="2h", Value="2"},
                    new SelectListItem{Text="24h", Value="24"}
                }, new { @class = "width-70" })
            </div>
            <div class="submit">
                <input type="submit" value="@ViewResource.Submit" />
            </div>
        </div>
    </section>
}
<table class="grid" style="width: 85.2%">
    <thead>
        <tr>
            <th class="width-100">
                MatchId
            </th>
            <th class="width-70">
                Total Affected Refno(s)
            </th>
            <th class="width-200">
                Session
            </th>
            <th class="width-100">
                SPName
            </th>
            <th class="width-70">
                CreatedDate
            </th>
            <th class="width-30">
                Action
            </th>
        </tr>
    </thead>
    <tbody>
        @{
            int i = 1;
            var matches = ViewBag.Matches as List<MatchParlayLocking>;
            if (matches != null && matches.Count > 0)
            {
                foreach (MatchParlayLocking match in matches)
                {
                    var row_class = i % 2 == 0 ? "alt" : string.Empty;

                    <tr class="@row_class">
                        <td class="align-center">
                            @match.MatchId
                        </td>
                        <td class="align-center">
                            @match.TotalAffectedRefno
                        </td>
                        <td class="align-center">
                            @match.Session
                        </td>
                        <td class="align-center">
                            @match.SPName
                        </td>
                        <td class="align-center">
                            @match.CreatedDate.ToString("MMM dd, yyyy hh:mm:ss tt")
                        </td>
                        <td class="align-center">
                            <input type="button" value="Delete" onclick="return deleteSession(@match.MatchId, '@match.Session');" />
                        </td>
                    </tr>
                    i++;
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="align-center">
                        @ViewResource.NoInformationAvailable
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
@section Foot {
    <script src="~/scripts/TempVariable/ParlayLocking.js" type="text/javascript"></script>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
    </script>
}