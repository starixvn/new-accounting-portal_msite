@{
    ViewBag.Title = "Update System Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/css/manage")
}
@section Headline {
    <h1>
        <span class="title">@ViewBag.Title</span>
    </h1>
}
@using (Html.BeginForm())
{
    <table class="grid" style="width: 40%">
        <thead>
            <tr>
                <th class="width-100">
                    VID
                </th>
                <th class="width-300">
                    VName
                </th>
                <th class="width-300">
                    VValue
                </th>
                <th class="width-60">
                    Action
                </th>
            </tr>
        </thead>
        <tbody>
            @{
                var setting = ViewBag.SystemSetting as SystemSettings;
                if (setting != null)
                {

                    <tr>
                        <td class="align-center">
                            @setting.VId
                        </td>
                        <td>
                            @setting.VName
                        </td>
                        <td class="align-center">
                            @setting.VValue
                        </td>
                        <td class="align-center">
                            @if (setting.VValue.Equals("1"))
                            {
                                <input type="submit" value="Update" onclick="return confirm('Are you sure you want to UPDATE System Settings?')" />
                            }
                            else
                            {
                                <div style="border: 1px solid gray; padding: 3px 0">Update</div>
                            }
                        </td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="4" class="align-center">
                            @ViewResource.NoInformationAvailable
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}