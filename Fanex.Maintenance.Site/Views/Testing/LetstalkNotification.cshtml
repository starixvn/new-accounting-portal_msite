@{
    ViewBag.Title = ViewResource.LetstalkNotification;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head{
    @Styles.Render("~/css/manage")
    @Styles.Render("~/css/letstalk-notification")
}
@section HeadLine
{
    <h1>
        <span class="title">@ViewBag.Title</span>
    </h1>
}
<div id="filter-bar" class="letstalk-notification">
    <div class="filter-form">
        <div class="filter-cell">
            <div class="lbl-field lt-label">@ViewResource.Message</div>
            <div class="edit-field lt-content">
                <input type="text" class="scrollabletextbox" id="message" value="" placeholder="Input your message" />
            </div>
        </div>
        <div class="filter-select">
            <div class="lbl-field lt-label">@ViewResource.Environment</div>
            <div class="edit-field lt-select" id="filter-select">
                <input type="radio" id="production" class="env" name="env" value="production" checked> @ViewResource.Environment_Production<br>
                <input type="radio" id="uAT" class="env" name="env" value="UAT"> @ViewResource.Environment_UAT<br>
            </div>
        </div>
        <div class="submit">
            <input id="btnSubmit" name="btnSave" type="submit" value="Submit">
        </div>
    </div>
    <div class="filter-notify">
        <p id="notify-email" class=""></p>
        <p id="notify-msg" class=""></p>
    </div>
</div>
<script type="text/javascript">window.rootUrl = '@Url.Content("~")'</script>
@section scripts {
    @Scripts.Render("~/scripts/letstalk-notification")
}