  <NapSettings Environment="LIVE"
               EnableDirectLogin="1" SiteId="8" EnableReCheckin="true"
               HubUrl="http://123.51.196.23/NapHub"
               UnauthorizeUrl="~/UserLogin/Common/Unauthorize"
               ServiceUrls="http://vn-net-lb-fb2f50db9dc92512.elb.ap-northeast-1.amazonaws.com:1710/api" AccessKey="rT4ASpI64euOkNDGWn+hrCHqkxYBCOSmMcBnw9Bnut8=">
  </NapSettings>
  <ONEbook.UM ServiceUris="http://vn-net-lb-fb2f50db9dc92512.elb.ap-northeast-1.amazonaws.com:8889/api" EnableCheckUM="true" EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" SiteId="2000000"></ONEbook.UM>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider,Fanex.Data" resourcePath="~/App_Data/" enableWatching="1" ignoreExceptionIsNotParameters="1" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.2.27.19\private$\entlib" defaultCategory="mSite" />
  <connectionStrings configSource="WebConnectionString.config"></connectionStrings>
  <LetstalkNotificationSetting NotificationService1="http://10.40.40.112/NotificationService/" NotificationService2="http://10.40.40.140/NotificationService/" AuthenticationKey="d7la9omvq6hte3oqtq7e" TargetNameAlert="cwl-alert" TargetNameMailing="cwl-mailing" TargetNameAlertUAT="cwl-alert-uat" TargetNameMailingUAT="cwl-mailing-uat" ITALLAlert="ITALLAlert" ITALLMail="ITALLMail" />
