    <add key="webpages:Version" value="2.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="PreserveLoginUrl" value="true" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="app_mail_id" value="1" />
    <add key="app_mail_address" value="net.tcp://vn-net-lb-fb2f50db9dc92512.elb.ap-northeast-1.amazonaws.com:8585/MailService" />
    <add key="GMTShowLog" value="7" />
    <add key="MailPermission:Application" value="ViewAccountingReportMail:1;ViewAccountingServiceReportMail:16;ViewNAPSpecialDeleteMail:22" />
    <add key="RemovedLogCategories" value="Alpha-789y,DCS-,Alpha-y987,NG2,Activity-Tracking,AccountingSite,NAP-CM,NAP-External,NAP-Home,NAP-U3,Nap-Accounting,Alpha-,NAP-Alpha-U3" />
    <add key="LetstalkApiUrl" value="http://10.99.99.51:7309/" />
    <add key="DbListXMLPath" value="~/Areas/TracingSp/AppData/AWS/DBServerList.xml" />
    <add key="SiteXMLPath" value="~/Areas/TracingSp/AppData/Sites.xml" />
