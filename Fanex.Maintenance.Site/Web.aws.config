    <add key="MailStation:RabbitMQConnectionString" value="host=vn-net-lb-fb2f50db9dc92512.elb.ap-northeast-1.amazonaws.com;virtualHost=/MailStationHost;username=rabbitclient" />
    <add key="MailStation:ClientNotifyTimeOutInSecond" value="20" />
