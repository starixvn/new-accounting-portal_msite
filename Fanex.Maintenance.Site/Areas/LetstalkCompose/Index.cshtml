@{
    ViewBag.Title = "Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/css/manage")
    @Styles.Render("~/css/compose-letstalk")
    @Styles.Render("~/themes/fanexgridstyles")
    <link href="~/scripts/lib/Fanex.Multiselect/fanex.multiSelect.css" rel="stylesheet" type="text/css" />
    <link href="~/themes/shared/contextmenu.less" rel="stylesheet" type="text/css" />
    <link href="~/themes/manage/LetstalkReport.less" rel="stylesheet" type="text/css" />
}
@section Headline {
    <h1>
        Compose Letstalk
    </h1>
}
<section id="filter-bar" class="compose-letstalk">
    <div class="filter-form">
        <div class="filter-row">
            <div class="lbl-field width-100">
                Letstalk Group
            </div>
            <div class="edit-field ddl-group">
                <select id="group"></select>
            </div>
        </div>
        <div class="filter-row">
            <div class="lbl-field width-100">
                Title
            </div>
            <div class="edit-field width-60">
                <input type="text" class="width-290" id="title" value="" />
            </div>
        </div>
        <div class="filter-row">
            <div class="lbl-field width-100">
                Message
            </div>
            <div class="edit-field lt-content">
                <textarea id="message" style="width: 402px; height: 152px;" placeholder="Input your message"></textarea>
            </div>
        </div>
        <div class="filter-row">
                <div class="lbl-field width-100">
                    Attched file(s)
                </div>
                <div class="edit-field width-auto">
                    <input type="file" id="myFile" name="myFile" multiple onchange="letstalkComposeController.updateList()" class="width-95"> (Maximum size: 15MB)
                    <div id="fileList" class="inline-flex"></div>
                </div>
            </div>
        <div class="filter-row">
            <div class="lbl-field width-100">

            </div>
            <div class="edit-field">
                @Html.TextBox("ConfigSendTime", "ConfigSendTime", new { @Value = DateTime.Now.ToString("MMM dd,yyyy"), style = "width: 100px" })
            </div>
            <div class="lbl-field width-20">
                HH:
            </div>
            <div class="edit-field width-60">
                <input type="text" class="width-60 input-number" id="hh" value="" />
            </div>
            <div class="lbl-field width-20">
                MM:
            </div>
            <div class="edit-field">
                <input type="text" class="width-60 input-number" id="mm" value="" />
            </div>
        </div>
        <div class="filter-row">
            <div class="lbl-field width-100">
            </div>
            <div class="submit">
                <input id="button-create" type="submit" value="Create" />
            </div>
        </div>
    </div>
</section>
<section id="body">
    @*<div id="letstalk-compose-container" class="letstalk-compose-container">
            <div id="letstalk-compose" class="freegrid display-none">
            </div>
        </div>*@
    @Html.Hidden("imagePath", (string)@Url.Content("~/images/calendar.gif"))
</section>
@section Foot {
    @Scripts.Render("~/scripts/sharedscripts")
    @Scripts.Render("~/scripts/fanexgridscripts")
    <script src="~/scripts/lib/Fanex.Multiselect/fanex.multiSelect.js" type="text/javascript"></script>
    <script src="~/scripts/lib/ContextMenu/ContextMenuController.js" type="text/javascript"></script>
    <script src="~/scripts/lib/custom-datepicker.js" type="text/javascript"></script>
    <script src="~/scripts/lib/Popup/dialogbox.js" type="text/javascript"></script>
    <script src="~/Areas/LetstalkCompose/Scripts/LetstalkCompose.js" type="text/javascript"></script>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var viewResources = {
            CreateMailSuccessMsg: '@string.Format(ViewResource.AddSuccessMsg, "Letstalk", 5)'
        };
    </script>
}