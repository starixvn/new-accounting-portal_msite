@using Fanex.Letstalk.Notification.Params;
@model HttpGetLogParams
@{
    ViewBag.Title = "Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/css/manage")
    @Styles.Render("~/themes/fanexgridstyles")
    <link href="~/themes/shared/contextmenu.less" rel="stylesheet" type="text/css" />
}
@section Headline {
    <h1>
        Letstalk Report
    </h1>
}
<section id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.FromDate, "From")
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.FromDate, new { @Value = DateTime.Now.ToString("MMM dd,yyyy"), style = "width: 100px" })
            </div>
            <div class="lbl-field">
                @Html.LabelFor(m => m.ToDate, "To")
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.ToDate, new { @Value = DateTime.Now.ToString("MMM dd,yyyy"), style = "width: 100px" })
            </div>
            <div class="submit">
                <input id="button-search" type="submit" value="Submit" />
            </div>
        </div>
    </div>
</section>
<section id="body">
    <div id="letstalk-report-container" class="letstalk-report-container">
        <div id="letstalk-report" class="freegrid display-none">
        </div>
    </div>
    @Html.Hidden("imagePath", (string)@Url.Content("~/images/calendar.gif"))
</section>
@section Foot {
    @Scripts.Render("~/scripts/sharedscripts")
    @Scripts.Render("~/scripts/fanexgridscripts")
    <script src="~/scripts/lib/ContextMenu/ContextMenuController.js" type="text/javascript"></script>
    <script src="~/scripts/lib/custom-datepicker.js" type="text/javascript"></script>
    <script src="~/scripts/lib/Popup/dialogbox.js" type="text/javascript"></script>
    <script src="~/Areas/LetstalkReport/Scripts/LetstalkReportController.js" type="text/javascript"></script>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
    </script>
}
