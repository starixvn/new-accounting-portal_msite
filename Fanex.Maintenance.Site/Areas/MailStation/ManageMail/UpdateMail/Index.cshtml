@using Fanex.Maintenance.Repository;
@using Fanex.MailDelivery.MailStation.Resources;
@using Fanex.MailDelivery.MailStation.Criteria.MailManage;
@model UpdateMailCriteria
@{
    
    ViewBag.Title = "Update Mail";
    Layout = "~/Views/Shared/_LayoutWithTimer.cshtml";  
}
@section Head {
    @Styles.Render("~/scripts/lib/MagicSuggest/css")
    @Styles.Render("~/themes/sharedstyles")
    @Styles.Render("~/scripts/inputcomboboxstyles")
    @Styles.Render("~/Areas/MailStation/ManageMail/UpdateMail/UpdateMailStyles")
    @Styles.Render("~/scripts/lib/NexCron/css")
}
@section Headline {
    <h1>
        <span class="title"><span class="first">@Labels.SystemName / </span><span class="second">
            Manage Mail /</span>
            @ViewBag.Title
        </span>
        <div class="button-action">
            <a id="btnBackToList" class="lnk" href="~/MailStation/MailManage/Index">← Back
                to list</a>
        </div>
    </h1>
}
<section id="body">
    <div class="form">
        @Html.HiddenFor(m => m.MailID)
        <div id="validation-summary-row" class="form-row display-none">
            <div class="lbl-field width-100">
            </div>
            <div class="edit-field">
                <div id="validationSummary"></div>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.MailGroupID, "Group")
            </div>
            @Html.DropDownListFor(m => m.MailGroupID, (IEnumerable<SelectListItem>)ViewBag.ListMailGroup, new { @class = "combobox-autocomplete" })
            <a id="btn-add-group">+</a>
        </div>
        <div class="form-row">
            <div class="lbl-field width-100">
                @Html.LabelFor(m => m.MailName, "Mail Name", new { @class = "bold-weight" })
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.MailName)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.SiteID, "Site")
            </div>
            @Html.DropDownListFor(m => m.SiteID, (IEnumerable<SelectListItem>)ViewBag.ListSite, new { disabled = "disabled" })
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.TriggerType, "Trigger")
            </div>
            @Html.DropDownListFor(m => m.TriggerType, (IEnumerable<SelectListItem>)ViewBag.ListTriggerType, new { disabled = "disabled" })
        </div>
        <div class="form-row schedule-row display-none">
            <div class="lbl-field width-100">
            </div>
            <div id="nexCron">
            </div>
            @Html.HiddenFor(m => m.RepeatType)
            @Html.HiddenFor(m => m.CronExpression)
            @Html.HiddenFor(m => m.StartOn)
            @Html.HiddenFor(m => m.EndOn)
            @Html.HiddenFor(m => m.Attempt)
            @Html.HiddenFor(m => m.Interval)
        </div>
       @* <div class="form-row">
            <div class="lbl-field width-100">
                @Html.LabelFor(m => m.MailFrom, "From")
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.MailFrom)
            </div>
        </div>*@
        <div class="form-row">
            <div class="lbl-field width-100">
                @Html.LabelFor(m => m.MailTo, "To", new { @class = "bold-weight" })
            </div>
            <div class="float-left">
                @Html.TextBoxFor(m => m.MailTo, new { @class = "auto-complete" })
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-100">
                @Html.LabelFor(m => m.MailCc, "CC")
            </div>
            <div class="float-left">
                @Html.TextBoxFor(m => m.MailCc, new { @class = "auto-complete" })
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-100">
                @Html.LabelFor(m => m.MailBcc, "BCC")
            </div>
            <div class="float-left">
                @Html.TextBoxFor(m => m.MailBcc, new { @class = "auto-complete" })
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-100">
                @Html.LabelFor(m => m.Description, "Description")
            </div>
            <div class="edit-field">
                @Html.TextAreaFor(m => m.Description)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-100">
                @Html.LabelFor(m => m.IsActive, "Status")
            </div>
            <div class="edit-field">
                <div class="check-box" >
                    @Html.CheckBoxFor(m => m.IsActive, new { value = "false" })
                </div>
                <div class="check-box-text" >
                    Active
                </div>
                @*<input class="check-box" id="status" name="status" type="checkbox" value="false" />*@
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-100">
            </div>
            <div class="edit-field">
                <input id="button-save" type="submit" value="@ViewResource.Save" />
                <input id="button-cancel" type="reset" value="@ViewResource.Cancel" />
            </div>
        </div>
    </div>
    @Html.Hidden("imagePath", (string)@Url.Content("~/images/calendar.gif"))
</section>
@section Foot {
    @Scripts.Render("~/scripts/sharedscripts")
    @Scripts.Render("~/scripts/inputcomboboxscripts")
    @Scripts.Render("~/Areas/MailStation/ManageMail/UpdateMail/UpdateMailScripts")
    @Scripts.Render("~/scripts/lib/NexCron/js")
    @Scripts.Render("~/scripts/lib/MagicSuggest/js")
    <script type="text/javascript">
        var viewResources = {
            AddMailGroupSuccessMsg: '@MailStationResources.AddMailGroupSuccessMsg',
            UpdateMailSuccessMsg: '@string.Format(ViewResource.UpSuccessMsg, "Mail", 5)',
            InvalidEmailMsg: '@MailStationResources.InvalidEmailMsg',
            CancelUpdateMail: '@MailStationResources.CancelUpdateMail'
        };
    </script>
}
