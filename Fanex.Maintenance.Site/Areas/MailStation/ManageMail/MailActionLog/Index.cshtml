@using Newtonsoft.Json;
@using Fanex.MailDelivery.MailStation.Resources;
@using Fanex.MailDelivery.MailStation.Models;
@model List<MailActionLogModel>
@{
    ViewBag.Title = Labels.Log;
    var mailLog = JsonConvert.SerializeObject(Model);
}
<!DOCTYPE html>
<html lang="en" class="linen">
<head>
    <title>@ViewBag.Title</title>
    @Styles.Render("~/css/mail-manage")
    <link href="~/Areas/MailStation/ManageMail/MailActionLog/Styles/MailActionLog.less" rel="stylesheet" type="text/css" />
</head>
<body id="body">
    <div id="mail-log-container" class="mail-log-container">
        <div id="mail-log" class="freegrid display-none">
        </div>
    </div>
    @Scripts.Render("~/scripts/common")
    @Scripts.Render("~/scripts/sharedscripts")
    @Scripts.Render("~/scripts/fanexgridscripts")
    <script src="~/Areas/MailStation/ManageMail/MailActionLog/Scripts/MailActionLogController.js" type="text/javascript"></script>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var mailLog= @Html.Raw(mailLog);
        var viewResources = {
            Symbol_No: '@Labels.Symbol_No',
            Message: '@Labels.Message',
            Log_Time: '@Labels.Log_Time'
        };
    </script>
</body>
</html>
