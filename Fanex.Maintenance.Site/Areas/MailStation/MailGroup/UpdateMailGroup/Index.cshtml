@using Fanex.Maintenance.Repository;
@using Fanex.MailDelivery.MailStation.Resources;
@using Fanex.MailDelivery.MailStation.Criteria.MailGroup;
@model UpdateMailGroupCriteria
@{
    
    ViewBag.Title = "Update Group";
    Layout = "~/Views/Shared/_Layout.cshtml";  
}
@section Head {
    @Styles.Render("~/themes/sharedstyles")
    @Styles.Render("~/Areas/MailStation/MailGroup/UpdateMailGroupStyles")
}
@section Headline {
    <h1>
        <span class="title"><span class="first">@Labels.SystemName / </span><span class="second">
            Manage Group /</span>
            @ViewBag.Title
        </span>
        <div class="button-action">
            <a id="btnBackToList" class="lnk" href="~/MailStation/MailGroupManage/Index">← Back
                to list</a>
        </div>
    </h1>
}
<section id="body">
    <div class="form">
        <div id="validation-summary-row" class="form-row display-none">
            <div class="lbl-field width-100">
            </div>
            <div class="edit-field">
                <div id="validationSummary"></div>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-100">
                @Html.LabelFor(m => m.MailGroupName, "Group", new { @class = "bold-weight" })
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.MailGroupName)
                @Html.HiddenFor(m => m.MailGroupID)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-100">
                @Html.LabelFor(m => m.Description, "Description")
            </div>
            <div class="edit-field ">
                @Html.TextAreaFor(m => m.Description)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
            </div>
            <div class="edit-field">
                <input id="button-save" type="submit" value="@ViewResource.Save" />
                <input id="button-cancel" type="reset" value="@ViewResource.Cancel" />
            </div>
        </div>
    </div>
    @Html.Hidden("imagePath", (string)@Url.Content("~/images/calendar.gif"))
</section>
@section Foot {
    @Scripts.Render("~/scripts/sharedscripts")
    @Scripts.Render("~/Areas/MailStation/MailGroup/UpdateMailGroupScripts")
    <script type="text/javascript">
        var viewResources = {
            UpdateMailGroupSuccessMsg: '@string.Format(ViewResource.UpSuccessMsg, "Mail Group", 5)',
            CancelUpdateMailGroup: '@MailStationResources.CancelUpdateMailGroup'
        };
    </script>
}
