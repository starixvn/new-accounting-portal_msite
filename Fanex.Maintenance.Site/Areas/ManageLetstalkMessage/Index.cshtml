@{
    ViewBag.Title = "Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var hasEditRight = (bool)ViewBag.HasEdit;
}
@section Head {
    @Styles.Render("~/css/manage")
    @Styles.Render("~/css/manage-letstalk-message")
    @Styles.Render("~/themes/fanexgridstyles")
    <link href="~/scripts/lib/Fanex.Multiselect/fanex.multiSelect.css" rel="stylesheet" type="text/css" />
    <link href="~/scripts/lib/DatetimePicker/jquery.datetimepicker.css" rel="stylesheet" type="text/css" />
    <link href="~/themes/shared/contextmenu.less" rel="stylesheet" type="text/css" />
    <link href="~/themes/manage/LetstalkReport.less" rel="stylesheet" type="text/css" />
}
@section Headline {
    <h1>
        <span class="title"><span class="black-text">Letstalk Notification </span> / Manage Letstalk Message</span>
        @if (hasEditRight)
        {
            @Html.ActionLink("+ Create New", "CreateLetstalkMessage", "ManageLetstalkMessage", null, new { @class = "lnk" })
        }
    </h1>
}
<section id="filter-bar" class="compose-letstalk">
    <div class="filter-form">
        <div class="filter-row">
            <div class="lbl-field width-100">
                From
            </div>
            <div class="edit-field width-250">
                @Html.TextBox("FromDate", "FromDate", new { @Value = DateTime.Now.ToString("MMM dd,yyyy"), style = "width: 100px" })
            </div>
            <div class="lbl-field width-100">
                To
            </div>
            <div class="edit-field">
                @Html.TextBox("ToDate", "ToDate", new { @Value = DateTime.Now.ToString("MMM dd,yyyy"), style = "width: 100px" })
            </div>
        </div>
        <div class="filter-row">
            <div class="lbl-field width-100">
                Letstalk Group
            </div>
            <div class="edit-field ddl-group width-250">
                @Html.DropDownList("LetstalkGroup", (List<SelectListItem>)ViewBag.LetstalkGroupList, new { @class = "width-250" })
            </div>
            <div class="lbl-field width-100">
                Status
            </div>
            <div class="edit-field ddl-status">
                @Html.DropDownList("Status", (List<SelectListItem>)ViewBag.StatusList)
            </div>
            <div class="submit">
                <input id="btnSubmit" type="submit" value="Submit" />
            </div>
        </div>
    </div>
</section>
<section id="body">
    <div id="manage-letstalk-message-container" class="manage-letstalk-message-container">
        <div id="manage-letstalk-message" class="freegrid display-none">
        </div>
    </div>
    @Html.Hidden("imagePath", (string)@Url.Content("~/images/calendar.gif"))
</section>
@section Foot {
    @Scripts.Render("~/scripts/sharedscripts")
    @Scripts.Render("~/scripts/fanexgridscripts")
    <script src="~/scripts/lib/Fanex.Multiselect/fanex.multiSelect.js" type="text/javascript"></script>
    <script src="~/scripts/lib/ContextMenu/ContextMenuController.js" type="text/javascript"></script>
    <script src="~/scripts/lib/custom-datepicker.js" type="text/javascript"></script>
    <script src="~/scripts/lib/DatetimePicker/jquery.datetimepicker.js" type="text/javascript"></script>
    <script src="~/scripts/lib/Popup/dialogbox.js" type="text/javascript"></script>
    <script src="~/Areas/ManageLetstalkMessage/Scripts/ManageLetstalkMessage.js" type="text/javascript"></script>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var viewResources = {
            CreateMailSuccessMsg: '@string.Format(ViewResource.AddSuccessMsg, "Letstalk", 5)'
        };
    </script>
}