@model Fanex.Tool.TraceSP.Models.TracingSp
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/css/manage")
    @Styles.Render("~/themes/fanexgridstyles")
    <link href="~/themes/shared/contextmenu.less" rel="stylesheet" type="text/css" />
}
@section Headline {
    <h1>
        Tracing Store Procedure
    </h1>
}
<section id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.Server, "Server")
            </div>
            <div class="edit-field width-180">
                @Html.DropDownListFor(m => m.Server, new SelectList(Model.Servers, "Ip", "Name"), new { @class = "width-180" })
            </div>
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.Site, "Site")
            </div>
            <div class="edit-field width-180">
                @Html.DropDownListFor(m => m.Site, new SelectList(Model.Sites, "Id", "Name"), new { @class= "width-180" })
            </div>
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.TraceTimer, "Trace Timer")
            </div>
            <div class="edit-field width-60">
                @Html.TextBoxFor(m => m.TraceTimer, new { @Value = "60", @class = "width-60" })
            </div>
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.TextDataLike, "Text Like")
            </div>
            <div class="edit-field width-180">
                @Html.TextBoxFor(m => m.TextDataLike, new { @class = "width-180", @Value = "%NAP_%" })
            </div>
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.TextDataLike2, "Text Like 2")
            </div>
            <div class="edit-field width-180">
                @Html.TextBoxFor(m => m.TextDataLike2, new { @class = "width-180", @Value = "%EXEC%" })
            </div>
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.TextDataLike3, "Text Like 3")
            </div>
            <div class="edit-field width-180">
                @Html.TextBoxFor(m => m.TextDataLike3, new { @class = "width-180", @Value = "%Select%" })
            </div>
            <div class="submit margin-left">
                <input id="button-search" type="submit" value="Submit" />
            </div>
        </div>
    </div>
</section>
<section id="body">
    <div id="tracingsp-container">
        <div id="tracingsp-report" class="freegrid display-none">
        </div>
    </div>    
</section>
@section Foot {
    @Scripts.Render("~/scripts/sharedscripts")
    @Scripts.Render("~/scripts/fanexgridscripts")
    <script src="~/scripts/lib/ContextMenu/ContextMenuController.js" type="text/javascript"></script>
    <script src="~/scripts/lib/custom-datepicker.js" type="text/javascript"></script>
    <script src="~/scripts/lib/Popup/dialogbox.js" type="text/javascript"></script>
    <script src="~/Areas/TracingSp/Scripts/TracingSpController.js" type="text/javascript"></script>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
    </script>
}