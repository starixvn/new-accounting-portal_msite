<configuration>
  <configSections>
    <section name="dotless" type="dotless.Core.configuration.DotlessConfigurationSectionHandler, dotless.Core" />
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    <section name="NapSettings" type="Fanex.NAP.Core.Configuration.NapSettings, Fanex.NAP.Core.Client" />
    <sectionGroup name="bundleTransformer">
      <section name="core" type="BundleTransformer.Core.Configuration.CoreSettings, BundleTransformer.Core" />
    </sectionGroup>
    <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
    <section name="LetstalkNotificationSetting" type="Fanex.Maintenance.Core.Model.LetstalkNotification.Setting, Fanex.Maintenance.Core" />
  </configSections>

  <NapSettings
    Environment="UAT"
    EnableDirectLogin="1"
    SiteId="12"
    EnableReCheckin="false"
    HubUrl="localhost:54332/NAPHub"
    UnauthorizeUrl="~/UserLogin/Common/Unauthorize"
    ServiceUrls="http://10.18.200.131:8788">
  </NapSettings>
  
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider,Fanex.Data" resourcePath="~/App_Data/" enableWatching="1" ignoreExceptionIsNotParameters="1" />
    </providers>
  </Fanex.Data.DbSettingProvider>

  <connectionStrings configSource="WebConnectionString.config"></connectionStrings>
  <LetstalkNotificationSetting NotificationService1="http://10.40.40.112/NotificationService/" NotificationService2="http://10.40.40.140/NotificationService/" AuthenticationKey="d7la9omvq6hte3oqtq7e" TargetNameAlert="cwl-alert" TargetNameMailing="cwl-mailing" TargetNameAlertUAT="cwl-alert-uat" TargetNameMailingUAT="cwl-mailing-uat" ITALLAlert="ITALLAlert" ITALLMail="ITALLMail" />
  <appSettings>
