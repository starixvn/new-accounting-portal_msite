<?xml version="1.0" encoding="utf-8" ?>
<Functions>
  <Function Name="Manage Mail">
    <Setting Key="MailStation_GetAllMailGroup" SpName="Mail_MailManagement_GetAllMailGroup" DbName="DBMMS.bodb_MMS.bodbAdminNet">
      <Mapping DataField="MailGroupID" ObjectProperty="Value" />
      <Mapping DataField="MailGroupName" ObjectProperty="Text" />
    </Setting>
    <Setting Key="MailStation_GetAllSites" SpName="NAP_Site_GetAll" DbName="DBNAP.bodb_NAP.bodbAdminNet">
      <Mapping DataField="SiteId" ObjectProperty="Value" />
      <Mapping DataField="SiteName" ObjectProperty="Text" />
    </Setting>
    <Setting Key="MailStation_GetAllSuggestedMails" SpName="Mail_MailManagement_GetSuggesionEmailList" DbName="DBMMS.bodb_MMS.bodbAdminNet">
      <Mapping DataField="EmailID" ObjectProperty="id" />
      <Mapping DataField="EmailAddress" ObjectProperty="name" />
    </Setting>
    <Setting Key="Mail_MailManagement_GetScheduleByMailId" SpName="Mail_MailManagement_GetScheduleByMailId" DbName="DBMMS.bodb_MMS.bodbAdminNet" >
      <Mapping DataField="MailID" ObjectProperty="Id" />
      <Mapping DataField="SiteId" ObjectProperty="SiteId" />
      <Mapping DataField="MailName" ObjectProperty="Name" />
      <Mapping DataField="CronExpression" ObjectProperty="RepeatExpression" />
      <Mapping DataField="StartOn" ObjectProperty="StartTime" />
      <Mapping DataField="EndOn" ObjectProperty="EndTime" />
      <Mapping DataField="IsActive" ObjectProperty="Active" />
      <Mapping DataField="Interval" ObjectProperty="RetryInterval" />
      <Mapping DataField="Attempt" ObjectProperty="MaxRetryTimes" />
    </Setting>
  </Function>
  
  <Function Name="Manage Group">
    <Setting Key="MailStation_Group_GetMailGroup" SpName="Mail_Group_GetMailGroup" DbName="DBMMS.bodb_MMS.bodbAdminNet" />
    <Setting Key="MailStation_Group_CreateMailGroup" SpName="Mail_Group_InsertGroup" DbName="DBMMS.bodb_MMS.bodbAdminNet" />
    <Setting Key="MailStation_Group_UpdateMailGroup" SpName="Mail_Group_UpdateGroup" DbName="DBMMS.bodb_MMS.bodbAdminNet" />
    <Setting Key="MailStation_Group_DeleteMailGroup" SpName="Mail_Group_DeleteGroup" DbName="DBMMS.bodb_MMS.bodbAdminNet" />
    <Setting Key="MailStation_Group_GetMailGroupByID" SpName="Mail_Group_GetMailGroupByID" DbName="DBMMS.bodb_MMS.bodbAdminNet" />
  </Function>
  
  <Function Name="MailDeliver">
    <Setting Key="StoreMail" SpName="MailRecorder_InsRecord" DbName="DBMA.bodb_Maintenance.bodbAdminNet"  />
  </Function>
</Functions>
